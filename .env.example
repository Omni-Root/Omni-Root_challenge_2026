# Copie este arquivo para ".env" (na mesma pasta) e preencha com os
# valores reais. O .env real NUNCA deve ir pro Git — só este exemplo.
#
#   cp .env.example .env

SQLITE_PATH=./omni_root_local.db

PG_HOST=192.168.1.100
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DBNAME=desafio_madeira

# segundos entre tentativas de sincronização (padrão no código: 30)
SYNC_INTERVALO_SEG=30

# --- Câmera ao vivo no dashboard (opcional) ---
# Token compartilhado com o dashboard (STREAM_TOKEN no .env de lá). O main.py
# só transmite se "stream_url" estiver preenchido no config.json E este token
# existir. Gere um valor qualquer longo (ex.: python -c "import secrets;print(secrets.token_hex(24))").
STREAM_TOKEN=
